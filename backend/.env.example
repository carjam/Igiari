# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Local eval: bypass 10 scans/hour IP limit when running run_eval.py (billing off only)
# IGIARI_DISABLE_RATE_LIMIT=1

# Supabase (billing / accounts)
SUPABASE_URL=https://YOUR_REFERENCE_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here
SUPABASE_ANON_KEY=your_publishable_key_here

# Site URL (Stripe Checkout return URLs)
SITE_URL=http://localhost:8080

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Products → create in test mode, copy price_... IDs)
STRIPE_PRICE_STARTER_PACK=price_...
STRIPE_PRICE_CASUAL_SUB=price_...

# Legal tier (optional until /legal outreach — see docs/STRIPE_GO_LIVE.md)
STRIPE_PRICE_LEGAL_STARTER=price_...
STRIPE_PRICE_LEGAL_SOLO_SUB=price_...
