{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Write(*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pip uninstall *)",
      "Bash(npm uninstall *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(backend/.env)",
      "Read(backend/.env.*)",
      "Read(frontend/.env)",
      "Read(frontend/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(backend/.env)",
      "Edit(backend/.env.*)",
      "Edit(frontend/.env)",
      "Edit(frontend/.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(backend/.env)",
      "Write(backend/.env.*)",
      "Write(frontend/.env)",
      "Write(frontend/.env.*)"
    ]
  }
}
